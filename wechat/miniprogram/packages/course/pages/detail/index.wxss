.detail-hero {
  padding: 34rpx;
}

.code-row,
.section-card-head,
.source-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.course-code {
  color: #2449b8;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.type-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #3655b3;
  font-size: 22rpx;
  font-weight: 700;
}

.type-badge.core {
  background: #e8f7ee;
  color: #167047;
}

.course-title {
  margin-top: 20rpx;
  color: #14213d;
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.3;
}

.course-subtitle {
  margin-top: 16rpx;
  color: #6b7588;
  font-size: 24rpx;
  line-height: 1.6;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 30rpx;
}

.actions button {
  margin: 0;
}

.term-switcher {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 26rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #f1f4f9;
}

.term-option {
  min-width: 0;
  height: 66rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: transparent;
  color: #637087;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 66rpx;
}

.term-option.is-active {
  background: #2855d9;
  color: #ffffff;
}

.term-context {
  margin-top: 12rpx;
  color: #637087;
  font-size: 21rpx;
}

.selection-status,
.eligibility-panel {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.selection-status {
  background: #f3f5f8;
  color: #5b6678;
}

.selection-status.is-ready {
  background: #eaf7ef;
  color: #18734b;
}

.selection-status.is-waiting,
.eligibility-panel.is-unmet {
  background: #fff5eb;
  color: #98520b;
}

.selection-status.is-unavailable {
  background: #f8ecee;
  color: #a43645;
}

.eligibility-panel.is-met {
  background: #eaf7ef;
  color: #18734b;
}

.eligibility-title {
  margin-bottom: 6rpx;
  font-weight: 850;
}

.eligibility-state {
  margin-top: 6rpx;
  opacity: 0.9;
}

.eligibility-confirmation {
  display: flex;
  margin-top: 12rpx;
  align-items: flex-start;
  color: #384862;
}

.eligibility-confirmation checkbox {
  flex: 0 0 auto;
  margin: 1rpx 10rpx 0 0;
  transform: scale(0.82);
  transform-origin: left top;
}

.section-pickers {
  display: grid;
  gap: 16rpx;
  margin-top: 20rpx;
}

.section-pickers label > text {
  display: block;
  margin-bottom: 9rpx;
  color: #4e5b70;
  font-size: 21rpx;
  font-weight: 700;
}

.picker-control {
  display: flex;
  min-height: 72rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #ced7e5;
  border-radius: 15rpx;
  background: #ffffff;
  color: #263654;
  font-size: 22rpx;
}

.picker-control text {
  margin-left: 16rpx;
  color: #2855d9;
  font-weight: 750;
}

.unavailable-button {
  background: #f4e8ea;
  color: #a72d3c;
  opacity: 1;
}

.document-button {
  grid-column: 1 / -1;
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #172e73;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
}

.review-card {
  padding: 30rpx;
  border-left: 8rpx solid #d89e32;
}

.review-card.level-recommended {
  border-left-color: #209565;
}

.review-card.level-caution {
  border-left-color: #d47f2c;
}

.review-verdict,
.review-summary,
.source-text {
  display: block;
}

.review-verdict {
  color: #273858;
  font-size: 28rpx;
  font-weight: 850;
}

.review-summary {
  margin-top: 14rpx;
  color: #4a566d;
  line-height: 1.75;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tags text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eff3f9;
  color: #536178;
  font-size: 22rpx;
}

.fact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.fact {
  box-sizing: border-box;
  min-width: 0;
  padding: 24rpx;
}

.fact text {
  display: block;
}

.fact text:first-child {
  color: #778196;
  font-size: 22rpx;
}

.fact text:last-child {
  margin-top: 10rpx;
  color: #28344d;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.section-list,
.source-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.section-card,
.source-card {
  padding: 28rpx;
}

.section-card.is-selectable {
  transition: transform 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
}

.section-card.is-selected {
  border-color: #2855d9;
  background: #f7f9ff;
  box-shadow: inset 0 0 0 1rpx #2855d9;
}

.section-card-pressed {
  transform: scale(0.992);
}

.section-card-status {
  display: flex;
  flex: 0 0 auto;
  max-width: 260rpx;
  align-items: flex-end;
  flex-direction: column;
  gap: 10rpx;
}

.section-name {
  display: block;
  color: #1c2d52;
  font-size: 32rpx;
  font-weight: 850;
}

.section-kind,
.section-meta,
.source-platform {
  display: block;
  color: #778196;
  font-size: 22rpx;
  line-height: 1.6;
}

.registration {
  max-width: 250rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: #fff1f2;
  color: #b42335;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: right;
}

.registration.available {
  background: #e8f7ee;
  color: #18734b;
}

.section-choice {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #edf2ff;
  color: #3153ad;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.3;
}

.section-choice.is-selected {
  background: #2855d9;
  color: #ffffff;
}

.section-time {
  margin-top: 20rpx;
  color: #263654;
  font-weight: 800;
}

.section-meta {
  margin-top: 7rpx;
}

.section-note {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 10rpx;
  background: #f6f8fb;
  color: #6b7588;
  font-size: 21rpx;
}

.source-intro,
.data-note {
  color: #737f93;
  font-size: 23rpx;
  line-height: 1.7;
}

.source-intro {
  margin: -4rpx 0 18rpx;
}

.source-title {
  color: #263654;
  font-weight: 800;
  line-height: 1.45;
}

.copy-link {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 16rpx;
  background: #edf2ff;
  color: #3153ad;
  font-size: 20rpx;
  line-height: 58rpx;
}

.source-text {
  margin-top: 20rpx;
  color: #48556d;
  font-size: 25rpx;
  line-height: 1.78;
  white-space: pre-wrap;
}

.data-note {
  margin: 38rpx 4rpx 16rpx;
}
