page {
  min-height: 100%;
  background: #f3f6fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button {
  font: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx;
}

.page-title {
  margin: 0;
  color: #15213a;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.65;
}

.surface {
  box-sizing: border-box;
  border: 1rpx solid #dce3ee;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(39, 54, 85, 0.07);
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.primary-button {
  background: #2855d9;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #cfd8e7;
  background: #ffffff;
  color: #2849a9;
}

.danger-button {
  background: #fff1f2;
  color: #b42335;
}

.empty-state {
  padding: 80rpx 36rpx;
  color: #7a8699;
  line-height: 1.7;
  text-align: center;
}

.section-heading {
  margin: 36rpx 0 18rpx;
  color: #1e2a44;
  font-size: 32rpx;
  font-weight: 800;
}
