.course-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid #dce3ee;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(39, 54, 85, 0.06);
}

.course-card-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.course-code-row,
.course-meta,
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.course-code {
  color: #2448a8;
  font-size: 30rpx;
  font-weight: 850;
}

.course-type {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #485dcc;
  font-size: 19rpx;
  font-weight: 750;
}

.course-type.core {
  background: #e9f8ef;
  color: #18794e;
}

.course-title {
  margin-top: 10rpx;
  color: #1a2438;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.45;
}

.add-button {
  width: 68rpx;
  min-width: 68rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: #2855d9;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.add-button.is-added {
  background: #e9f8ef;
  color: #18794e;
}

.add-button.is-unavailable {
  background: #eef1f5;
  color: #7b8494;
  opacity: 1;
}

.add-button.is-ineligible {
  background: #fff1e7;
  color: #b54708;
  opacity: 1;
}

.course-meta {
  margin-top: 18rpx;
  color: #697586;
  font-size: 21rpx;
}

.course-meta text + text::before {
  margin-right: 12rpx;
  color: #c0c8d5;
  content: "·";
}

.course-schedule {
  margin-top: 12rpx;
  color: #44526a;
  font-size: 23rpx;
  line-height: 1.55;
}

.course-schedule-picker {
  display: block;
  margin-top: 10rpx;
}

.course-schedule-selector {
  box-sizing: border-box;
  display: flex;
  min-height: 88rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  align-items: center;
  justify-content: space-between;
  background: #f4f7fc;
  transition: background 120ms ease, transform 120ms ease;
}

.course-schedule-selector:active {
  background: #eaf0fb;
  transform: scale(0.99);
}

.course-schedule-value {
  min-width: 0;
  color: #44526a;
  font-size: 23rpx;
  line-height: 1.5;
}

.course-schedule-action {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #2855d9;
  font-size: 21rpx;
  font-weight: 750;
  white-space: nowrap;
}

.course-eligibility {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #fff5eb;
  color: #98520b;
  font-size: 21rpx;
  line-height: 1.55;
}

.course-eligibility.is-met {
  background: #eaf7ef;
  color: #18734b;
}

.eligibility-confirmations {
  margin-top: 14rpx;
}

.eligibility-confirmation {
  display: flex;
  min-height: 48rpx;
  align-items: flex-start;
  color: #44526a;
  font-size: 22rpx;
  line-height: 1.55;
}

.eligibility-confirmations checkbox-group + checkbox-group {
  margin-top: 8rpx;
}

.eligibility-confirmation checkbox {
  flex: 0 0 auto;
  margin: 1rpx 10rpx 0 0;
  transform: scale(0.82);
  transform-origin: left top;
}

.course-review {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f6f8fc;
}

.review-verdict {
  display: inline-block;
  margin-right: 12rpx;
  color: #2849a9;
  font-size: 22rpx;
  font-weight: 800;
}

.review-verdict.level-caution {
  color: #b54708;
}

.review-verdict.level-recommended {
  color: #18794e;
}

.review-summary {
  color: #5d6879;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-row {
  margin-top: 16rpx;
}

.tag {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  color: #52637e;
  font-size: 19rpx;
}
