<view class="course-card" bindtap="openCourse">
  <view class="course-card-head">
    <view>
      <view class="course-code-row">
        <text class="course-code">{{course.code}}</text>
        <text class="course-type {{course.requirementType}}">{{course.requirementLabel}}</text>
      </view>
      <view class="course-title">{{course.title}}</view>
    </view>
    <button class="add-button {{added ? 'is-added' : ''}} {{!course.addable ? 'is-unavailable' : ''}} {{!course.canAdd && !added && course.addable ? 'is-ineligible' : ''}}" catchtap="toggleCourse" disabled="{{!course.addable || (!course.canAdd && !added)}}" aria-label="{{!course.addable ? '该学期暂无可选班次' : (!course.canAdd && !added ? '暂不符合选课条件' : (added ? '从课表移除' : '加入课表'))}}">
      {{!course.addable ? '…' : (!course.canAdd && !added ? '!' : (added ? '✓' : '+'))}}
    </button>
  </view>

  <view class="course-meta">
    <text>{{course.credits}} 学分</text>
    <text>{{course.sectionLabel}}</text>
    <text>{{course.webLabel}}</text>
  </view>
  <picker
    wx:if="{{course.primaryChoices.length}}"
    class="course-schedule-picker"
    mode="selector"
    range="{{course.primaryChoices}}"
    range-key="label"
    value="{{course.primaryIndex}}"
    bindchange="changeSection"
    catchtap="noop"
    aria-label="选择{{course.code}}班次和时间，当前{{course.scheduleText}}"
  >
    <view class="course-schedule-selector" role="button">
      <text class="course-schedule-value">{{course.scheduleText}}</text>
      <text class="course-schedule-action">{{course.scheduleActionLabel}}</text>
    </view>
  </picker>
  <view wx:else class="course-schedule">{{course.scheduleText || '暂无可展示班次'}}</view>

  <view wx:if="{{course.eligibilityNote}}" class="course-eligibility {{course.eligibilityMet ? 'is-met' : 'is-unmet'}}">
    {{course.eligibilityNote}}
  </view>
  <checkbox-group wx:if="{{course.requiresConfirmation}}" bindchange="confirmEligibility" catchtap="noop">
    <label class="eligibility-confirmation">
      <checkbox
        value="{{course.confirmationKey}}"
        checked="{{course.confirmationMet}}"
        disabled="{{added && course.confirmationMet}}"
      />
      <text>我确认：{{course.confirmationLabel}}</text>
    </label>
  </checkbox-group>

  <view class="course-review">
    <text class="review-verdict level-{{course.recommendation.level}}">{{course.recommendation.verdict}}</text>
    <text class="review-summary">{{course.recommendation.summary}}</text>
  </view>

  <view class="tag-row" wx:if="{{course.displayTags.length}}">
    <text class="tag" wx:for="{{course.displayTags}}" wx:key="*this">{{item}}</text>
  </view>
</view>
